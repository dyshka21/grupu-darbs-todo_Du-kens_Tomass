<!--Tomass Dučkens versija 1-->
<!DOCTYPE html>
<html lang="lv">
<head>
  <meta charset="UTF-8">
  <title>Mani darbi V3</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    .task-text { cursor: pointer; transition: 0.2s; }
    .text-decoration-line-through { color: #adb5bd; opacity: 0.7; }
    
    .priority-badge { width: 80px; text-align: center; }
  </style>
</head>

<body class="bg-light">

<div class="container mt-5">
  <div class="card p-4 shadow-sm">
    <h3 class="mb-4 text-center">Todo List V3</h3>

    <div class="input-group mb-3">
      <select id="izvele" class="form-select form-select-sm w-auto flex-grow-0">
        <option value="zema">Zema</option>
        <option value="videja">Vidēja</option>
        <option value="liela">SVARĪGI</option>
      </select>
      <input id="task-input" type="text" class="form-control" placeholder="Ieraksti darbu...">
      <button onclick="addTask()" class="btn btn-primary">Pievienot</button>
    </div>

    <div class="row g-2 mb-3">
      <div class="col-md-7">
        <input id="search-input" type="text" class="form-control" placeholder="Meklēt uzdevumu..." oninput="renderTasks()">
      </div>
      <div class="col-md-5">
        <div class="btn-group w-100" role="group">
          <button type="button" id="btn-visi" class="btn btn-outline-secondary active" onclick="setFilter('visi')">Visi</button>
          <button type="button" id="btn-aktive" class="btn btn-outline-secondary" onclick="setFilter('aktīvie')">Aktīvie</button>
          <button type="button" id="btn-pabeigtie" class="btn btn-outline-secondary" onclick="setFilter('pabeigtie')">Pabeigtie</button>
        </div>
      </div>
    </div>

    <ul id="task-list" class="list-group mb-3"></ul>

    <div class="d-flex justify-content-between align-items-center border-top pt-3">
      <span id="task-count" class="text-muted small">Atlikuši 0 darbi</span>
      <button class="btn btn-link btn-sm text-danger text-decoration-none" onclick="clearCompleted()">Notīrīt pabeigtos</button>
    </div>

  </div>
</div>

<script>
let currentFilter = 'visi';


function addTask() {
  const input = document.getElementById("task-input");
  const select = document.getElementById("izvele");

  if (input.value.trim() === "") return;

  const tasks = JSON.parse(localStorage.getItem("tasks")) || [];
  tasks.push({
    text: input.value,
    done: false,
    priority: select.value 
  });

  localStorage.setItem("tasks", JSON.stringify(tasks));
  input.value = "";
  renderTasks();
}

 
function setFilter(filter) {
  currentFilter = filter;

  document.getElementById('btn-visi').classList.toggle('active', filter === 'visi');
  document.getElementById('btn-aktive').classList.toggle('active', filter === 'aktīvie');
  document.getElementById('btn-pabeigtie').classList.toggle('active', filter === 'pabeigtie');
  renderTasks();
}


function renderTasks() {
  const taskList = document.getElementById("task-list");
  const searchTerm = document.getElementById("search-input").value.toLowerCase();
  const tasks = JSON.parse(localStorage.getItem("tasks")) || [];
  
  taskList.innerHTML = "";
  let activeCount = 0;

  tasks.forEach((task, index) => {
    if (!task.done) activeCount++;

    
    const matchesSearch = task.text.toLowerCase().includes(searchTerm);
    const matchesFilter = 
      currentFilter === 'visi' || 
      (currentFilter === 'aktīvie' && !task.done) || 
      (currentFilter === 'pabeigtie' && task.done);

    if (matchesSearch && matchesFilter) {
      const li = document.createElement("li");
      li.className = "list-group-item d-flex justify-content-between align-items-center";


      let pClass, pText;
      if (task.priority === "liela") {
        pClass = "bg-danger";
        pText = "SVARĪGI";
      } else if (task.priority === "videja") {
        pClass = "bg-warning text-dark";
        pText = "Vidēja";
      } else {
        pClass = "bg-success";
        pText = "Zema";
      }

      li.innerHTML = `
        <div class="d-flex align-items-center flex-grow-1">
          <span class="badge ${pClass} me-3 priority-badge">${pText}</span>
          <span class="task-text ${task.done ? 'text-decoration-line-through' : ''}" 
                onclick="toggleTask(${index})">${task.text}</span>
        </div>
        <div class="btn-group">
          <button class="btn btn-sm btn-outline-info" onclick="editTask(${index})">Labot</button>
          <button class="btn btn-sm btn-outline-danger" onclick="deleteTask(${index})">Dzēst</button>
        </div>
      `;
      taskList.appendChild(li);
    }
  });

  
  document.getElementById("task-count").textContent = `Atlikuši ${activeCount} darbi`;
}


function toggleTask(index) {
  const tasks = JSON.parse(localStorage.getItem("tasks"));
  tasks[index].done = !tasks[index].done;
  localStorage.setItem("tasks", JSON.stringify(tasks));
  renderTasks();
}


function deleteTask(index) {
  const tasks = JSON.parse(localStorage.getItem("tasks"));
  tasks.splice(index, 1);
  localStorage.setItem("tasks", JSON.stringify(tasks));
  renderTasks();
}

 
function clearCompleted() {
  let tasks = JSON.parse(localStorage.getItem("tasks")) || [];
  tasks = tasks.filter(task => !task.done);
  localStorage.setItem("tasks", JSON.stringify(tasks));
  renderTasks();
}

 
function editTask(index) {
  const tasks = JSON.parse(localStorage.getItem("tasks"));
  const currentText = tasks[index].text;
  const newText = prompt("Labot uzdevumu:", currentText);
  
  if (newText !== null && newText.trim() !== "") {
    tasks[index].text = newText;
    localStorage.setItem("tasks", JSON.stringify(tasks));
    renderTasks();
  }
}


window.addEventListener("DOMContentLoaded", renderTasks);
</script>

</body>
</html>
</html>
