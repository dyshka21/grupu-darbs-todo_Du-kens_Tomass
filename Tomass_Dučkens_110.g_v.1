<!--Tomass Dučkens versija 1-->
<!DOCTYPE html>
<html lang="lv">
<head>
  <title>Mani darbi</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">

<div class="container mt-5">
  <div class="card p-4 shadow-sm">

    <h3 class="mb-4 text-center">Mani darbi</h3>

    <div class="input-group mb-3">
        <select id="izvele" class="form-select form-select-sm w-auto flex-grow-0">
            <option value="zema">Zema</option>
            <option value="videja">Videja</option>
            <option value="liela">SVARIGS!</option>
        </select>
      <input id="task-input" type="text" class="form-control" placeholder="Ievadi jaunu darbu">
      <button onclick="addTask()" class="btn btn-primary">Pievienot</button>
    </div>

    <ul id="task-list" class="list-group"></ul>

  </div>
</div>

<script>
function addTask() {
  const input = document.getElementById("task-input");
  const select = document.getElementById("izvele");

  if (input.value === "") return;

  const li = document.createElement("li");
  li.className = "list-group-item d-flex justify-content-between align-items-center";

  const selectedText = select.options[select.selectedIndex].text;
  const selectedValue = select.value;

  let priorityClass = "btn-success";

  if (selectedValue === "liela") {
    priorityClass = "btn-danger";
  } 
  else if (selectedValue === "videja") {
    priorityClass = "btn-warning";
  }

  li.innerHTML = `
    <button class="btn btn-sm me-2 priority-btn ${priorityClass}">
      ${selectedText}
    </button>

    <span class="task-text flex-grow-1">${input.value}</span>

    <button class="btn btn-sm btn-outline-danger">
      Dzēst
    </button>
  `;

  document.getElementById("task-list").appendChild(li);

  const text = li.querySelector(".task-text");
  const deleteBtn = li.querySelector(".btn-outline-danger");

  deleteBtn.addEventListener("click", function () {
    li.remove();
    saveData();
  });

  text.addEventListener("click", function () {
    text.classList.toggle("text-decoration-line-through");
    saveData();
  });

  input.value = "";
  saveData();
}

function saveData(){
  const tasks = [];
  const items = document.querySelectorAll("#task-list li");

  items.forEach(li => {
    const text = li.querySelector(".task-text").textContent;
    const done = li.querySelector(".task-text")
      .classList.contains("text-decoration-line-through");

    let priority = "zema";
    const btn = li.querySelector(".priority-btn");

    if (btn.classList.contains("btn-danger")) {
      priority = "liela";
    } 
    else if (btn.classList.contains("btn-warning")) {
      priority = "videja";
    }

    tasks.push({text, done, priority});
  });

  localStorage.setItem("tasks", JSON.stringify(tasks));
}

function loadData(){
  const tasks = JSON.parse(localStorage.getItem("tasks")) || [];

  tasks.forEach(task => {

    let priorityText = "Zema";
    let priorityClass = "btn-success";

    if(task.priority === "liela"){
      priorityText = "SVARIGS!";
      priorityClass = "btn-danger";
    }
    else if(task.priority === "videja"){
      priorityText = "Videja";
      priorityClass = "btn-warning";
    }

    const li = document.createElement("li");
    li.className = "list-group-item d-flex justify-content-between align-items-center";

    li.innerHTML = `
      <button class="btn btn-sm me-2 priority-btn ${priorityClass}">
        ${priorityText}
      </button>

      <span class="task-text flex-grow-1">${task.text}</span>

      <button class="btn btn-sm btn-outline-danger">
        Dzēst
      </button>
    `;

    document.getElementById("task-list").appendChild(li);

    const text = li.querySelector(".task-text");
    const deleteBtn = li.querySelector(".btn-outline-danger");

    if(task.done){
      text.classList.add("text-decoration-line-through");
    }

    deleteBtn.addEventListener("click", function () {
      li.remove();
      saveData();
    });

    text.addEventListener("click", function () {
      text.classList.toggle("text-decoration-line-through");
      saveData();
    });

  });
}

window.addEventListener("DOMContentLoaded", loadData);
</script>

</body>
</html>
