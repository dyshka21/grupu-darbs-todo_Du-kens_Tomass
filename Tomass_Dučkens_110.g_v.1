<!--Tomass Dučkens versija 1-->
<!DOCTYPE html>
<html lang="lv">
<head>
  
  <title>Mani darbi</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">

<div class="container mt-5">
  <div class="card p-4 shadow-sm">

    <h3 class="mb-4 text-center">Mani darbi</h3>

    <div class="input-group mb-3">
        <select id="izvele" class="form-select form-select-sm w-auto flex-grow-0" aria-label=".form-select-lg example">
            <option value="zema">Zema</option>
            <option value="videja">Videja</option>
            <option value="liela">SVARIGS!</option>
        </select>
      <input id="task-input" type="text" class="form-control" placeholder="Ievadi jaunu darbu" >
      <button onclick="addTask()" class="btn btn-primary">Pievienot</button>
    </div>

    <ul id="task-list" class="list-group"></ul>

  </div>
</div>

<script>
function addTask() {
  const input = document.getElementById("task-input");
  if (input.value === "") return;

  const li = document.createElement("li");
  li.className = "list-group-item d-flex justify-content-between align-items-center";

  li.innerHTML = `
    <span class="task-text">${input.value}</span>
    <button class="btn btn-sm btn-outline-danger"
            onclick="this.parentElement.remove(); saveData();">
      Dzēst
    </button>
  `;

  document.getElementById("task-list").appendChild(li);
  input.value = "";
  
  
    const text = li.querySelector(".task-text");
    const deleteBtn = li.querySelector("button");
  
    text.addEventListener("click", function () {
      text.classList.toggle("text-decoration-line-through");
      saveData();
    });
    

    deleteBtn.addEventListener("click", function () {
    li.remove();
    saveData();
    });
    
    const izvele = document.getElementById("izvele").value;
     if (izvele === "liela") {
    li.classList.add("list-group-item-danger"); // sarkans
    saveData();
      } 
      else if (izvele === "videja") {
        li.classList.add("list-group-item-warning"); // dzeltens
        saveData();
      } 
      else {
        li.classList.add("list-group-item-success"); // zaļš
        saveData();
      }

saveData();
}

function saveData(){
  const tasks = [];
  const items = document.querySelectorAll("#task-list li");

  items.forEach(li => {
    const text = li.querySelector(".task-text").textContent;
    const done = li.querySelector(".task-text")
      .classList.contains("text-decoration-line-through");
      
      const priority = "low";

    if (li.classList.contains("list-group-item-danger")) {
      priority = "high";
    } 
    else if (li.classList.contains("list-group-item-warning")) {
      priority = "medium";
    }

    tasks.push({text, done, priority});
  });

  localStorage.setItem("tasks", JSON.stringify(tasks));
}


function loadData(){
  const tasks = JSON.parse(localStorage.getItem("tasks")) || [];
  const input = document.getElementById("task-input");

  tasks.forEach(task => {
    input.value = task.text;
    addTask();

    const last = document.querySelector("#task-list li:last-child");
    const text = last.querySelector(".task-text");

    if(task.done){
      text.classList.add("text-decoration-line-through");
    }
  });

  input.value = "";
}


window.addEventListener("DOMContentLoaded", loadData);





</script>

</body>
</html>
